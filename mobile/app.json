{
  "expo": {
    "name": "ParkWise",
    "slug": "parkwise",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.parkwise.app"
    },
    "android": {
      "package": "com.parkwise.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      "@react-native-community/datetimepicker"
    ]
  }
}
