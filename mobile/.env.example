# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Where "Forgot password" email links send the customer to actually set a
# new password - deploy web/reset-password.html somewhere public (same way
# as web/email-confirmed.html) and put that URL here. Also add it to
# Supabase: Authentication -> URL Configuration -> Redirect URLs.
# Without this, the reset link falls back to the Site URL (the "you're
# verified" page), which has no way to set a new password.
EXPO_PUBLIC_RESET_PASSWORD_URL=your_deployed_reset_password_page_url
